<IfModule mod_php.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
</IfModule>
# 設定・鍵ファイルはHTTPで取得できないようにする
<FilesMatch "^(config\.php|setup\.key|.*\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
