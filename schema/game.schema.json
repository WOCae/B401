{
  "schemaVersion": 2,
  "tileSize": 32,
  "level": {
    "maxRows": 60,
    "maxCols": 400,
    "requiredTiles": [
      "P"
    ]
  },
  "tiles": {
    ".": {
      "name": "空"
    },
    "#": {
      "name": "地面/ブロック",
      "solid": true
    },
    "^": {
      "name": "トゲ"
    },
    "o": {
      "name": "コイン"
    },
    "G": {
      "name": "ゴール"
    },
    "P": {
      "name": "開始位置"
    }
  },
  "fields": [
    {
      "path": "meta.title",
      "type": "string",
      "label": "タイトル",
      "default": "はじめてのステージ",
      "maxLength": 60
    },
    {
      "path": "physics.gravity",
      "type": "number",
      "label": "重力",
      "min": 800,
      "max": 3200,
      "step": 50,
      "default": 1800,
      "slider": true
    },
    {
      "path": "physics.moveSpeed",
      "type": "number",
      "label": "移動速度",
      "min": 100,
      "max": 360,
      "step": 5,
      "default": 200,
      "slider": true
    },
    {
      "path": "physics.jumpVelocity",
      "type": "number",
      "label": "ジャンプ力",
      "min": 300,
      "max": 900,
      "step": 10,
      "default": 620,
      "slider": true
    },
    {
      "path": "physics.accel",
      "type": "number",
      "label": "加速の鋭さ",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 14,
      "slider": true
    },
    {
      "path": "physics.coyoteTime",
      "type": "number",
      "label": "コヨーテタイム(秒)",
      "min": 0,
      "max": 0.25,
      "step": 0.01,
      "default": 0.08,
      "slider": true
    },
    {
      "path": "physics.jumpBuffer",
      "type": "number",
      "label": "ジャンプ先行入力(秒)",
      "min": 0,
      "max": 0.25,
      "step": 0.01,
      "default": 0.1,
      "slider": true
    },
    {
      "path": "player.hp",
      "type": "number",
      "label": "体力(ハート)",
      "min": 1,
      "max": 9,
      "step": 1,
      "default": 1,
      "slider": true,
      "group": "stats"
    },
    {
      "path": "player.lives",
      "type": "number",
      "label": "残機(0=無制限)",
      "min": 0,
      "max": 9,
      "step": 1,
      "default": 0,
      "slider": true,
      "group": "stats"
    },
    {
      "path": "player.doubleJump",
      "type": "bool",
      "label": "二段ジャンプ",
      "default": false,
      "group": "stats"
    },
    {
      "path": "player.hurtInvincible",
      "type": "number",
      "label": "ダメージ後の無敵(秒)",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 1.5,
      "slider": true,
      "group": "stats"
    },
    {
      "path": "theme.sky",
      "type": "color",
      "label": "空の色",
      "default": "#bfe3ff",
      "group": "view"
    },
    {
      "path": "theme.ground",
      "type": "color",
      "label": "地面の色",
      "default": "#6b4a2b",
      "group": "view"
    },
    {
      "path": "theme.player",
      "type": "color",
      "label": "プレイヤーの色",
      "default": "#e4572e",
      "group": "view"
    },
    {
      "path": "render.mode",
      "type": "enum",
      "label": "表示モード",
      "values": [
        "2d",
        "3d"
      ],
      "valueLabels": [
        "2D",
        "3D"
      ],
      "default": "2d",
      "group": "view"
    },
    {
      "path": "render.camera.type",
      "type": "enum",
      "label": "カメラの種類",
      "values": [
        "orthographic",
        "perspective"
      ],
      "valueLabels": [
        "正射投影",
        "透視投影"
      ],
      "default": "orthographic",
      "group": "view"
    },
    {
      "path": "render.camera.angle",
      "type": "number",
      "label": "カメラの角度(度)",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 0,
      "slider": true,
      "group": "view"
    },
    {
      "path": "render.camera.distance",
