        "none"
      ],
      "valueLabels": [
        "プレイヤー",
        "固定"
      ],
      "default": "player",
      "group": "view"
    },
    {
      "path": "render.depth",
      "type": "number",
      "label": "奥行きの厚み(タイル)",
      "min": 0.25,
      "max": 4,
      "step": 0.25,
      "default": 1,
      "slider": true,
      "group": "view"
    },
    {
      "path": "render.lighting",
      "type": "enum",
      "label": "ライティング",
      "values": [
        "default",
        "bright",
        "dim"
      ],
      "valueLabels": [
        "標準",
        "明るい",
        "暗い"
      ],
      "default": "default",
      "group": "view"
    },
    {
      "path": "assets.player.primitive.shape",
